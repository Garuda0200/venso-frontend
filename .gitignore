# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
# testing
/coverage

# Environment variables
.env
.env.local
.env.production
.env.development

# Auto-generated build files (DO NOT COMMIT)
/public/build-info.json
.env.local
NUL

# Overrides locales; la infraestructura privada se excluye más abajo.
/.env
.env.*
!.env.example
/.docker
docker-compose.override.yml
/fly.local.toml
/fly.*.local.toml
/Dockerfile.local
/.dockerignore.local

# Local configuration and logs
.idea/
.vscode/
*.log

# OS files
.DS_Store
Thumbs.db


# Ensure build artifacts and generated files stay ignored
/build
/dist

# Playwright (removed from project)
/playwright-report
/test-results
/e2e/.auth
/.next

# Lockfiles (if you prefer one package manager)
yarn.lock

# Playwright
/e2e/.auth/
/e2e/screenshots/
/test-results/
/playwright-report/

# Local compiled unit-test artifacts
/.tmp-feature-tests

# Infraestructura privada de despliegue: se conserva localmente, pero no se
# publica en el repositorio de código fuente.
/.dockerignore
/Dockerfile
/fly.toml
/nginx.conf
/docs/DEPLOY_FLY_FRONTEND.md
/scripts/Deploy-VensoFly.ps1
/*.zip

# Documentación privada: conservar en disco, fuera del repositorio de código.
# Se aplica también a subcarpetas, anexos de docs y README junto al código.
docs/
documentation/
documentacion/
contexts/
contextos/
manuals/
manuales/
*.md
*.mdx
*.rst
*.adoc
*.asciidoc
*.typ
*.tex
*.pdf
*.doc
*.docx
*.odt
*.rtf
*.ppt
*.pptx
README*
CHANGELOG*
CONTRIBUTING*
ARCHITECTURE*
INSTALL*

# Índice local de análisis; incluye referencias a documentación privada.
/graphify-out/
