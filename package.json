{
  "name": "venso-tours-frontend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@dnd-kit/core": "^6.0.8",
    "@dnd-kit/sortable": "^7.0.2",
    "@dnd-kit/utilities": "^3.2.1",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@zxing/browser": "^0.1.5",
    "axios": "^1.7.9",
    "chart.js": "^4.4.8",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "pdf-lib": "^1.17.1",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.3",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-datepicker": "^4.18.0",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.1.3",
    "react-toastify": "^11.0.3",
    "uuid": "^11.1.1",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "build": "npm run typecheck && vite build",
    "build:prod": "npm run typecheck && vite build --mode production",
    "preview": "vite preview",
    "build:sw": "esbuild src/workers/service-worker.ts --bundle --format=iife --target=es2020 --outfile=public/service-worker.js",
    "predev": "npm run build:sw",
    "prebuild": "npm run build:sw",
    "prebuild:prod": "npm run build:sw",
    "test:assignment-protection": "tsc -p tsconfig.assignment-tests.json && node .tmp-assignment-tests/src/components/Ventas/Cotizaciones/EdicionCotizacion/utils/__tests__/assignmentProtection.test.js && node -e \"require('fs').rmSync('.tmp-assignment-tests',{recursive:true,force:true})\"",
    "test:post-sale-security": "tsc -p tsconfig.feature-tests.json && node .tmp-feature-tests/src/pages/Ventas/Cotizaciones/utils/__tests__/postSaleEditState.test.js",
    "test:idempotency": "tsc -p tsconfig.feature-tests.json && node .tmp-feature-tests/src/utils/__tests__/idempotency.test.js",
    "test:passenger-pricing": "tsc -p tsconfig.feature-tests.json && node .tmp-feature-tests/src/components/Ventas/Cotizaciones/EdicionCotizacion/utils/__tests__/passengerPricingPresentation.test.js",
    "test": "npm run test:assignment-protection && npm run test:feature-suite",
    "test:feature-suite": "node scripts/run-feature-suite.cjs",
    "test:biblia-activities": "tsc -p tsconfig.feature-tests.json && node .tmp-feature-tests/src/pages/Reservas/Calendario/utils/__tests__/bibliaActivityMapper.test.js",
    "test:pricing-core": "tsc -p tsconfig.feature-tests.json && node .tmp-feature-tests/src/components/Ventas/Cotizaciones/EdicionCotizacion/utils/__tests__/externalChildPricing.test.js",
    "test:servicepicker-tariffs": "tsc -p tsconfig.feature-tests.json && node .tmp-feature-tests/src/components/Ventas/Cotizaciones/EdicionCotizacion/components/ServicePicker/utils/__tests__/tariffContext.test.js",
    "test:endose-pricing": "tsc -p tsconfig.feature-tests.json && node .tmp-feature-tests/src/components/Ventas/Cotizaciones/EdicionCotizacion/components/DaysEditor/utils/endosePricingPolicy.test.js",
    "test:ticket-tariff-grouping": "tsc -p tsconfig.feature-tests.json && node .tmp-feature-tests/src/components/Ventas/Cotizaciones/EdicionCotizacion/utils/__tests__/ticketTariffGrouping.test.js",
    "test:package-fee": "tsc -p tsconfig.feature-tests.json && node .tmp-feature-tests/src/utils/__tests__/packageFeeUtils.test.js",
    "test:grouped-hotel-persistence": "tsc -p tsconfig.feature-tests.json && node .tmp-feature-tests/src/components/Ventas/Cotizaciones/EdicionCotizacion/utils/__tests__/groupedHotelPersistence.test.js",
    "test:magic-parity": "tsc -p tsconfig.feature-tests.json && node .tmp-feature-tests/src/tests/magicParityVenso.test.js",
    "test:cotizacion-igv": "tsc -p tsconfig.feature-tests.json && node .tmp-feature-tests/src/pages/Ventas/Cotizaciones/utils/__tests__/cotizacionIgv.test.js",
    "test:cotizacion-list-state": "tsc -p tsconfig.feature-tests.json && node .tmp-feature-tests/src/pages/Ventas/Cotizaciones/utils/__tests__/cotizacionListState.test.js",
    "test:service-exchange-rate": "tsc -p tsconfig.feature-tests.json && node .tmp-feature-tests/src/components/Ventas/Cotizaciones/EdicionCotizacion/utils/__tests__/serviceExchangeRate.test.js",
    "test:reservation-voucher-preliquidacion": "tsc -p tsconfig.feature-tests.json && node .tmp-feature-tests/src/pages/Ventas/Cotizaciones/utils/__tests__/reservationVoucherPreliquidacion.test.js",
    "test:voucher-preliquidacion": "tsc -p tsconfig.feature-tests.json && node .tmp-feature-tests/src/pages/Ventas/Cotizaciones/utils/__tests__/voucherPreliquidacion.test.js",
    "test:voucher-financials": "tsc -p tsconfig.feature-tests.json && node .tmp-feature-tests/src/pages/Ventas/VouchersVenta/utils/__tests__/voucherFinancials.test.js",
    "test:session-csrf": "tsc -p tsconfig.feature-tests.json && node .tmp-feature-tests/src/utils/__tests__/csrfToken.test.js"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.15.3",
    "@types/prop-types": "^15.7.14",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.12",
    "sass": "^1.106.1",
    "typescript": "^5.8.3",
    "vite": "^8.3.5"
  },
  "description": "Sistema integral de turismo Venso Tours - frontend Vite + React + TypeScript",
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "packageManager": "npm@12.2.1"
}
