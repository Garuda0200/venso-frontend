# ===========================================
# CONFIGURACIÓN DEL FRONTEND
# ===========================================
# En desarrollo puede usarse /api con proxy de Vite, o la URL local del backend.
VITE_API_URL=/api
VITE_API_TIMEOUT=30000

# Wake same-origin del backend autosuspendido. Nginx traduce /api/health a
# /health del backend mediante API_UPSTREAM configurado en Fly.
VITE_BACKEND_WAKE_PATH=/api/health
VITE_BACKEND_WAKE_TIMEOUT_MS=30000
VITE_BACKEND_WAKE_MAX_ATTEMPTS=4
VITE_BACKEND_WAKE_RETRY_COOLDOWN_MS=10000

# ===========================================
# CACHÉ Y VALORES DE NEGOCIO
# ===========================================
VITE_TURISMO_CACHE_TTL_MS=300000
VITE_EXCHANGE_RATE=3

# ===========================================
# AUTENTICACIÓN
# ===========================================
# El sistema usa cookies de sesión HttpOnly enviadas por el backend.
# No configurar tokens en el frontend.

# ===========================================
# IDENTIDAD VENSO TOURS
# ===========================================
VITE_APP_NAME=Venso Tours
VITE_APP_PLATFORM=venso
VITE_BRAND_WEBSITE=https://vensotours.com
